{
  "schema_version": 1,
  "name": "short_exfiltration_phrase_variants_v1",
  "description": "Phrase and snippet-template bank for generating short embedded prompt-injection positives and matched benign quoted/discussion hard negatives. Snippets are intended to be inserted into otherwise benign carrier text.",
  "labels": {
    "positive": "prompt_injection",
    "negative": "benign"
  },
  "target_buckets": {
    "positive": "short_embedded_exfiltration_attack",
    "negative_quoted": "short_exfiltration_quoted_hard_negative",
    "negative_discussion": "short_exfiltration_discussion_hard_negative"
  },
  "recommended_generation": {
    "positive_train_rows": 12000,
    "positive_validation_rows": 1500,
    "negative_train_rows": 12000,
    "negative_validation_rows": 1500,
    "target_text_char_lengths": [
      160,
      220,
      320,
      460,
      640,
      900,
      1240
    ],
    "target_text_token_lengths": [
      32,
      48,
      64,
      96,
      128,
      192,
      256,
      384
    ],
    "held_out_validation_policy": "Hold out phrase families/templates/carrier parent_id combinations where possible; at minimum hold out carriers and a subset of base phrases."
  },
